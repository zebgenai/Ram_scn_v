# Copy to .env and fill in.  chmod 600 .env
# This is the SEPARATE "screen version" instance — its own subdomain and data,
# running alongside the original files.clevercampus.cloud without touching it.
PUBLIC_URL=https://scn.clevercampus.cloud
COMPANY_NAME=Assac
ADMIN_USER=admin
# Generate with:
#   docker run --rm -i remote-files-scn-server:latest hash-password
# then paste the full line. Keep the single quotes ($ signs inside).
ADMIN_PASSWORD_HASH='pbkdf2-sha256$600000$REPLACE$REPLACE'

# --- OnlyOffice (in-browser Excel editing) is DISABLED on this instance. ---
# Leave all three blank to keep Excel editing off (recommended here to save RAM).
# To enable: uncomment the onlyoffice service in docker-compose.yml and the office
# block in nginx/remote-files-scn.conf, then fill these in.
ONLYOFFICE_PUBLIC_URL=
ONLYOFFICE_JWT_SECRET=
INTERNAL_BASE_URL=
